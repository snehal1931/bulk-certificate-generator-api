# Application Configuration
APP_NAME="Bulk Certificate Generator API"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/certificate_db
# For SQLite (local testing): sqlite:///./certificate_generator.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/certificate_db

# Storage Configuration
STORAGE_DIR=storage/certificates

# Processing Configuration
MAX_RECIPIENTS_PER_JOB=1000
